{
  "name": "empires",
  "version": "1.1.0",
  "private": true,
  "description": "Empires — an original real-time strategy game in the spirit of the 1997 classics.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "node server/serve.mjs --dir dist --port 4173",
    "typecheck": "tsc -p tsconfig.sim.json && tsc -p tsconfig.app.json && tsc -p tsconfig.tools.json",
    "purity": "node tools/check-purity.ts",
    "test": "vitest run",
    "e2e": "playwright test",
    "verify": "node tools/verify.ts",
    "verify:full": "node tools/verify.ts --full",
    "tauri": "tauri"
  },
  "dependencies": {
    "@preact/signals": "2.11.2",
    "@tauri-apps/api": "2.12.0",
    "pixi.js": "8.21.0",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@preact/preset-vite": "2.10.6",
    "@tauri-apps/cli": "2.12.0",
    "@types/node": "22.20.4",
    "@types/pngjs": "6.0.5",
    "@types/three": "0.186.0",
    "maxrects-packer": "2.7.3",
    "oxc-parser": "0.152.0",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "three": "0.186.1",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
